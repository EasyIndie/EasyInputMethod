# Rust
/target/
**/*.rs.bk
*.pdb

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# pi 本地会话（不提交）
.pi/sessionDir/
.pi/sessions/

# 用量实验原始数据 / 临时工作区（保留 usage.jsonl）
docs/experiments/runs/raw/
docs/experiments/runs/bench-*/
docs/experiments/runs/sessions/

# 本地构建产物 / 临时数据
/dist/
/packaging/out/
/platforms/macos/build/
*.log

# data/sources/ 下只提交抓取脚本与项目自编的小表；其余数据大文件一律不入库
/data/sources/*
!/data/sources/*.sh
!/data/sources/README.md
# D17/D17-bis 自编简码表（CC-BY-SA-4.0，体积极小）：入库以便 CI 复算 B0（报告 251）
!/data/sources/wubi86-level1-codes.tsv
!/data/sources/wubi86-level2-codes.tsv
# D17-ter 三级简码（D9 衍生筛选，LGPL-3.0，约 40 KB）：入库以便 CI 复算核心表（ADR-345）
!/data/sources/wubi86-level3-codes.tsv

# 派生数据（可由 examples/oracle.rs 复现；PROVISIONAL，不入库，见 ADR-017）
/data/generated/wubi86-structure-laststroke.tsv

# oracle 派生的对照表（可由 fetch 脚本 + example 复现；含极点 provenance，不入库）
/data/generated/wubi86-oracle2-single.tsv

# 大型生成表（可由 fetch 脚本 + examples 复现，不入库）
/data/generated/wubi86-phrases.tsv
/data/generated/pinyin-words.tsv

# Python 回归运行缓存
__pycache__/
*.py[cod]
tools/eval/last-run.json
