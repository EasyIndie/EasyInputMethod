<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  萤火虫输入法 · macOS 宿主 Info.plist

  为最大化兼容，同时提供两种输入模式清单写法：
    - 顶层 tsInputModeListKey（第三方 IMK 惯例，Squirrel 等）
    - ComponentInputModeDict.tsInputModeListKey（Apple 内建 IME / Sogou 使用）
  键名依据本机实测（/System/Library/Input Methods/*.app 与 SogouWBInput.app）。

  ⚠️ 必须是 .app bundle（macOS 13 的 LaunchServices 无法扫描 .inputmethod，
     实测报 -10811）——见 ADR-022 / platforms/macos/README.md。
  bundle 标识：cn.jokerhub.inputmethod.Lampyris（ADR-056，自有域名 jokerhub.cn 反向 DNS）。
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>Lampyris</string>
	<key>CFBundleIdentifier</key>
	<string>cn.jokerhub.inputmethod.Lampyris</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Lampyris</string>
	<key>CFBundleIconFile</key>
	<string>Lampyris.icns</string>
	<key>CFBundleDisplayName</key>
	<string>萤火虫</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSBackgroundOnly</key>
	<true/>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsSuddenTermination</key>
	<true/>
	<key>InputMethodConnectionName</key>
	<string>cn.jokerhub.inputmethod.Lampyris_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>LampyrisInputController</string>
	<key>TISIntendedLanguage</key>
	<string>zh-Hans</string>
	<key>TISIconIsTemplate</key>
	<true/>
	<key>tsInputMethodIconFileKey</key>
	<string>LampyrisTemplate.png</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Latn</string>
		<string>Hans</string>
	</array>
	<key>tsInputModeListKey</key>
	<dict>
		<key>cn.jokerhub.inputmethod.Lampyris.default</key>
		<dict>
			<key>TISInputSourceID</key>
			<string>cn.jokerhub.inputmethod.Lampyris.default</string>
			<key>TISIntendedLanguage</key>
			<string>zh-Hans</string>
			<key>tsInputModeScriptKey</key>
			<string>smSimpChinese</string>
			<key>tsInputModePrimaryInScriptKey</key>
			<true/>
			<key>tsInputModeDefaultStateKey</key>
			<true/>
			<key>tsInputModeIsVisibleKey</key>
			<true/>
			<key>tsInputModeMenuIconFileKey</key>
			<string>LampyrisTemplate.png</string>
			<key>tsInputModePaletteIconFileKey</key>
			<string>LampyrisTemplate.png</string>
			<key>tsInputModeAlternateMenuIconFileKey</key>
			<string>LampyrisTemplate.png</string>
		</dict>
	</dict>
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>cn.jokerhub.inputmethod.Lampyris.default</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>cn.jokerhub.inputmethod.Lampyris.default</string>
				<key>TISIntendedLanguage</key>
				<string>zh-Hans</string>
				<key>tsInputModeScriptKey</key>
				<string>smSimpChinese</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeMenuIconFileKey</key>
				<string>LampyrisTemplate.png</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>LampyrisTemplate.png</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>cn.jokerhub.inputmethod.Lampyris.default</string>
		</array>
	</dict>
</dict>
</plist>
